---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	preflight(preflight)
	profiler_agent(profiler_agent)
	quality_agent(quality_agent)
	risk_review(risk_review)
	apply_corrections(apply_corrections)
	etl_agent(etl_agent)
	finalize(finalize)
	report(report)
	__end__([<p>__end__</p>]):::last
	__start__ --> preflight;
	apply_corrections -. &nbsp;continue&nbsp; .-> etl_agent;
	apply_corrections -. &nbsp;stop&nbsp; .-> report;
	etl_agent -. &nbsp;continue&nbsp; .-> finalize;
	etl_agent -. &nbsp;stop&nbsp; .-> report;
	preflight -. &nbsp;continue&nbsp; .-> profiler_agent;
	preflight -. &nbsp;stop&nbsp; .-> report;
	profiler_agent -. &nbsp;continue&nbsp; .-> quality_agent;
	profiler_agent -. &nbsp;stop&nbsp; .-> report;
	quality_agent -. &nbsp;stop&nbsp; .-> report;
	quality_agent -. &nbsp;continue&nbsp; .-> risk_review;
	risk_review -. &nbsp;continue&nbsp; .-> apply_corrections;
	risk_review -. &nbsp;stop&nbsp; .-> report;
	finalize --> __end__;
	report --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
