# ------------------------------------------------------------------
# BIFlow · optional settings
# Copy this file as .env (at the project root), fill in what you need, then restart the API.
# Without a .env file, BIFlow works normally: email + password accounts, notifications in the app only.
# Never put the .env file on GitHub (it is already in .gitignore).
# ------------------------------------------------------------------

# ---------- Sign in with Google (optional) ----------
# OAuth client ID of type "Web application", created for free on https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost  and  http://localhost:3000
# It looks like 1234567890-abc123def456.apps.googleusercontent.com (it is public: not a secret, not a paid API key)
BIFLOW_GOOGLE_CLIENT_ID=

# ---------- Email notifications (optional) ----------
# Gmail: sending server and port
BIFLOW_SMTP_HOST=smtp.gmail.com
BIFLOW_SMTP_PORT=587

# Gmail address that SENDS the emails (for example an address created for the project)
BIFLOW_SMTP_USER=

# APP password (16 letters), NOT the Gmail account password.
# Create it on https://myaccount.google.com/apppasswords (2-Step Verification must be on).
BIFLOW_SMTP_PASSWORD=

# Sender shown in the email (leave empty to use the address above)
BIFLOW_MAIL_FROM=

# Address of the website, used by the "View the results" button in the email
BIFLOW_APP_URL=http://localhost:3000
